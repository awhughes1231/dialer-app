# Copy to .env. Never commit the filled-in file.

# App
DATABASE_URL=postgresql://dialer:dialer@localhost:5432/dialer
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3010
AUTH_TRUST_HOST=true
PUBLIC_APP_URL=http://localhost:3010

# Google Workspace sign-in. Create an OAuth client (Web) and set the
# redirect URI to ${PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this domain can sign in, unless ALLOWED_EMAILS is set.
ALLOWED_EMAIL_DOMAIN=ecommercewala.co
# Optional exact allow-list. When set, the domain check is not used.
ALLOWED_EMAILS=
# These addresses are admins (call log, number pool, DNC). Everyone else is a rep.
ADMIN_EMAILS=
# Local only. Never enable this on a public host.
AUTH_DEV_LOGIN=false

# Twenty CRM. The dialer does not modify Twenty until you run the setup script.
TWENTY_MODE=mock
TWENTY_API_URL=https://crm.ecommercewala.co
TWENTY_APP_URL=https://crm.ecommercewala.co
TWENTY_API_KEY=
# Also write a timeline note, in addition to the Call record.
TWENTY_MIRROR_NOTES=true
TWENTY_NEXT_FOLLOW_UP_FIELD=nextFollowUp

# mock | telnyx | twilio (twilio is an intentional stub)
TELEPHONY_MODE=mock
TELNYX_API_KEY=
# Mission Control → Account Settings → Keys & Credentials → Public Key
TELNYX_PUBLIC_KEY=
# Credential connection id (the parent SIP connection, not a single telephony credential)
TELNYX_CONNECTION_ID=
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# Used only when the pool has no active number.
TELNYX_DEFAULT_CALLER_ID=
# Optional. When set, disclosure uses this audio file instead of Telnyx speak/TTS.
TELNYX_DISCLOSURE_AUDIO_URL=
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300

# Comma-separated purchased numbers:
# +14155552671:CA:415:default:San Francisco,+12125552671:NY:212::New York
CALLER_ID_NUMBERS=

# announce plays the notice and records. skip does not record in all-party states.
RECORDING_TWO_PARTY_MODE=announce
RECORDING_ANNOUNCE_IN_ONE_PARTY=true
# Replace the default list entirely when counsel wants a different set.
# ALL_PARTY_STATES=CA,CT,FL,IL,MD,MA,MI,MT,NV,NH,OR,PA,WA
COMPLIANCE_UNKNOWN_TZ=block
CALLING_WINDOW_START=08:00
CALLING_WINDOW_END=21:00

# Seeds fictional 555 caller IDs and one DNC row so the UI works with no Telnyx account.
# Leave false in production. Demo numbers are ignored when TELEPHONY_MODE=telnyx.
SEED_DEMO_DATA=false
